# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/.next.old*/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
# local Cloudflare API token read by scripts/deploy.mjs (never commit)
.cf-token

# vercel / cloudflare
.vercel
.wrangler
.dev.vars

# drizzle local artefacts
/drizzle/meta
.open-next/

# scraper cache and intermediate scrape output
# (re-create with: python scripts/scrape-catalog.py && python scripts/scrape-content.py)
/.source-cache/
/scripts/source-catalog.json
/scripts/source-content.json

# build-time generated runtime data (small JSONs rebuilt by npm run build)
/src/data/site-nav.json
/src/data/home-summary.json
/src/data/admin-columns-meta.json

# local build/deploy logs
/*.log
.open-next-*/

# locally uploaded files during dev (created by /api/admin/upload)
/public/uploads/
/public/downloads/

# one-off translation workspace + DB backups (kept locally only)
/.zh-work/
/.zh-backup-*.json
/.audit-backup-*.json
/.local-media/
