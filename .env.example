# ---------------------------------------------------------------------------
# Asia Pacific Industry Group — mirrored website (boppfilmsales.com / apigcl.com)
# Copy this file to `.env.local` and fill in your own values.
#
# Both domains serve ONE database. `www.boppfilmsales.com` runs on Cloudflare
# Workers and reaches D1 through the `DB` binding in wrangler.jsonc, so on
# Workers none of the CLOUDFLARE_* variables below are needed. `www.apigcl.com`
# runs on Vercel, where the binding does not exist, so it talks to the same D1
# database over the HTTP query API and needs all of them.
# ---------------------------------------------------------------------------

# --- Admin (/admin) ---------------------------------------------------------
ADMIN_USERNAME=xgxadmin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie.
# MUST be identical on Vercel and Cloudflare, otherwise a session created on one
# deployment is rejected by the other (and by the upload forwarder).
SESSION_SECRET=change-me-to-a-long-random-string

# --- Cloudflare D1 over HTTP (Vercel only) ----------------------------------
# Without the Worker binding, the data layer falls back to these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# Token needs the "D1: Edit" permission for the account above.
CLOUDFLARE_API_TOKEN=

# --- Media (Vercel only) ----------------------------------------------------
# Base URL of the deployment that owns the R2 bucket. When set off-Workers,
# `/api/media/*` redirects there and `/api/admin/upload` forwards to it, so the
# second domain serves the same images without S3 signing or double storage.
# e.g. https://www.boppfilmsales.com
MEDIA_ORIGIN=

# --- Local development only -------------------------------------------------
# `next dev` has neither the D1 binding nor the Cloudflare variables above, so
# it falls back to the build-time snapshot in src/data/.
# Legacy Neon Postgres connection string, kept for the D1 → Neon backup script.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
