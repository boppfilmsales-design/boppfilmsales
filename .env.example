# ---------------------------------------------------------------------------
# Asia Pacific Industry Group — mirrored website (apigcl.com / boppfilmsales.com)
# Copy this file to `.env` and fill in your own values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (only needed for the dynamic Next.js deployment).
# The static export (npm run export:static) does NOT need a database at all.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin (Site Background) credentials for /admin
ADMIN_USERNAME=xgxadmin
ADMIN_PASSWORD=xgxadmin

# Secret used to sign the admin session cookie — change this in production
SESSION_SECRET=change-me-to-a-long-random-string
